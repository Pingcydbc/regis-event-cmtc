RewriteEngine On

# ป้องกันการเข้าถึงไฟล์ .env
<Files .env>
    Order allow,deny
    Deny from all
</Files>

# 1. ปลายทาง /dashboard ให้ไปที่ dashboard.php
RewriteRule ^dashboard$ dashboard.php [L]

# 2. ปลายทางอื่นๆ ที่ไม่มีนามสกุล .php ให้ลองเติม .php (Optional)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
